install_toolbox=true
install_mods=true

# ---------------------------------------------------------------------------
# Hồ sơ hiệu năng cao (PERF_TURBO)
#   true  = ép persist.sys.computility.cpulevel/gpulevel=4, powermode=0,
#           tắt Dynamic FPS (dfps), bật scroll_opt...
#           -> mượt hơn nhưng RẤT NÓNG và tụt pin, nhất là 1-2 giờ đầu sau flash.
#   false = giữ thiết lập tiết kiệm điện của ROM gốc (khuyến nghị).
PERF_TURBO=false

# Ép Smart FPS 120Hz trong device_features. Chỉ nên bật nếu panel hỗ trợ LTPO;
# trên panel LTPS thường, màn hình sẽ không xuống được tần số thấp -> nóng máy.
FORCE_SMART_FPS=false

# Tự thêm GMS + bật Dịch vụ Google mặc định trên ROM China (true/false)
GMS_DEFAULT=true

# ---------------------------------------------------------------------------
# Cách mod Settings.apk
#   false = mod đè TRỰC TIẾP vào Settings.apk của ROM: giải nén -> patch smali
#           -> build lại -> vá logo. Không cần file APK đóng gói sẵn, repo nhẹ.
#   true  = dùng Settings_kashi.apk.xz (bản đóng gói sẵn, có thêm card MyDevice
#           + thanh dung lượng) nếu file tồn tại trong máy build.
# ---------------------------------------------------------------------------
USE_KASHI_SETTINGS=false
