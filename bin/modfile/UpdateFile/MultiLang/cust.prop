persist.sys.timezone=Asia/Ho_Chi_Minh
ro.product.locale.language=vi
ro.product.locale.region=VN
ro.miui.region=VN
ro.miui.cust_variant=vn
ro.vendor.miui.region=VN
ro.vendor.miui.cust_variant=vn

# Cấu hình đánh thức màn hình và hiển thị đầy đủ nội dung thông báo
wake_up_for_notification=1
lock_screen_show_notifications=1
lock_screen_allow_private_notifications=1
pref_key_enable_notification_body=1
lock_screen_show_only_unseen_notifications=0

# Kích hoạt sẵn Dịch vụ Google cơ bản (GMS) mặc định
ro.miui.has_gmscore=1
persist.sys.miui.google.services=1
persist.sys.google.enable=1
ro.com.google.clientidbase=android-xiaomi
ro.opa.eligible_device=true
